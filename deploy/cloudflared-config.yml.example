# Cloudflare named tunnel for Shadow IRC.
#
# Copy to /etc/cloudflared/config.yml and replace TUNNEL_ID with the id that
# `cloudflared tunnel create shadow-irc` prints.
#
# The tunnel carries HTTP and WebSocket only. TLS terminates at the Cloudflare
# edge, so the local service is plain http on loopback — that is expected, not
# a downgrade. Raw TCP (IRC on 6697) cannot go through a free tunnel; that
# needs Cloudflare Spectrum, which is paid.

tunnel: TUNNEL_ID
credentials-file: /etc/cloudflared/TUNNEL_ID.json

# Keep WebSocket sessions alive. IRC connections idle for long stretches
# between messages, and the daemon already pings every 30s.
originRequest:
  connectTimeout: 30s
  noTLSVerify: false

ingress:
  - hostname: app.shadowspace.space
    service: http://127.0.0.1:8888

  # Anything else that reaches this tunnel is not ours.
  - service: http_status:404
