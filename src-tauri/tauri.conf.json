{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHADOW-IRC",
  "version": "4.1.0",
  "identifier": "com.shadow.irc",
  "build": {
    "frontendDist": "../src-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "SHADOW // IRC [Deep Space Network]",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "useHttpsScheme": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ]
  }
}
