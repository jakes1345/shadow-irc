{
  "name": "shadow-irc",
  "version": "4.0.0",
  "description": "SHADOW-IRC: Native Tauri v2 Desktop App (Linux, Windows, macOS) & Terminal TUI Suite with Deep Space Nebula Aesthetics.",
  "main": "src/server/ircd.js",
  "type": "module",
  "bin": {
    "shadow-ircd": "./bin/shadow-ircd",
    "shadow-irc": "./bin/shadow-irc"
  },
  "scripts": {
    "server": "node src/server/ircd.js",
    "client": "node src/client/tui.js",
    "desktop": "tauri dev",
    "build:desktop": "tauri build",
    "bot": "node src/bot/cosmicBot.js",
    "test": "node test/verify_v3.js",
    "install:icon": "python3 scripts/install_desktop_icon.py",
    "start": "node src/server/ircd.js",
    "tunnel": "cloudflared tunnel --url ws://localhost:8888"
  },
  "keywords": [
    "irc",
    "ircd",
    "tui",
    "tauri-v2",
    "desktop-app",
    "space-theme",
    "nebula",
    "cosmos",
    "e2ee",
    "tcp-sockets",
    "rfc1459",
    "rfc2812"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "neo-blessed": "^0.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
